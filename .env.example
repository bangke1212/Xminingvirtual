# ZXOXO Bot — contoh konfigurasi
# SALIN file ini menjadi `.env` di VPS kamu, lalu isi nilainya.
# JANGAN PERNAH commit file `.env` ke git, dan JANGAN PERNAH kirim isinya ke siapa pun.
# Semua nilai di bawah ini HANYA placeholder — ganti dengan milikmu sendiri.

# ---------------------------------------------------------------------------
# MODE (baca dulu sebelum mengubah!)
# ---------------------------------------------------------------------------
# Default: CHECK-ONLY (hanya membaca status + melaporkan, TANPA transaksi).
#   AUTO_CLAIM=false  -> bot TIDAK PERNAH mengirim transaksi apa pun.
#   AUTO_CLAIM=true   -> bot boleh mengirim transaksi claim mZXO (butuh
#                        WALLET_PRIVATE_KEY + ZXO_COOKIE).
#   AUTO_PACKET=false -> bot TIDAK PERNAH mengirim packet LayerZero.
#   AUTO_PACKET=true  -> bot boleh mengirim packet LayerZero SETELAH claim
#                        berhasil (butuh AUTO_CLAIM=true juga).
# Bot TIDAK PERNAH membeli rig dan TIDAK PERNAH overclock/jump otomatis.
AUTO_CLAIM=false
AUTO_PACKET=false

# ---------------------------------------------------------------------------
# SESI X (Twitter) — opsional, tapi WAJIB untuk melihat saldo mining kamu
# dan untuk claim. Tanpa ini bot hanya bisa membaca statistik publik.
# ---------------------------------------------------------------------------
# Cara mendapatkan (di browser kamu sendiri, setelah login di zxoxo.xyz):
#   1. Buka https://zxoxo.xyz/mine (pastikan sudah login dengan X).
#   2. Tekan F12 -> tab Network -> muat ulang halaman.
#   3. Klik salah satu request ke /api/mine/state -> lihat "Request Headers".
#   4. Salin SELURUH nilai header "Cookie:" ke bawah ini (satu baris panjang).
# Cookie ini bisa kedaluwarsa — kalau bot mulai mencatat "401 / signed_out",
# ulangi langkah di atas dan perbarui .env ini, lalu restart bot.
ZXO_COOKIE=

# ---------------------------------------------------------------------------
# WALLET — WAJIB pakai wallet BURNER BARU (bukan wallet utama!)
# ---------------------------------------------------------------------------
# Buat wallet EVM baru khusus untuk bot ini, isi saldo KECIL saja (cukup untuk
# gas fee claim di 5 chain). Wallet ini HARUS sudah di-link ke akun ZXOXO kamu
# lewat situsnya (Connect wallet -> Link, 1x tanda tangan gratis) SEBELUM
# bot dijalankan, dan wallet ini yang dipakai untuk claim.
#
# WALLET_ADDRESS = alamat publik wallet burner (0x...). Dipakai untuk membaca
# saldo mZXO on-chain. Wajib diisi bila AUTO_CLAIM=true (atau bila kamu mau
# bot menampilkan saldo on-chain kamu).
WALLET_ADDRESS=
#
# WALLET_PRIVATE_KEY = private key wallet burner (0x... / 64 hex).
# HANYA di file .env ini, di VPS kamu sendiri. Jangan kirim ke siapa pun,
# jangan paste di chat, jangan commit. Tanpa ini bot tetap bisa jalan dalam
# mode CHECK-ONLY. Wajib diisi bila AUTO_CLAIM=true.
WALLET_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# BATAS KEAMANAN
# ---------------------------------------------------------------------------
# Klaim hanya bila mZXO yang tertunda >= nilai ini (dalam ZXO, default 1).
# Mencegah transaksi gas untuk jumlah receh.
MIN_CLAIM_ZXO=1
# Gas price maksimum (gwei) per transaksi claim/packet. Bila gas di atas ini,
# transaksi dilewati dan dicoba lagi pada siklus berikutnya.
MAX_GAS_PRICE_GWEI=10
# Margin fee packet LayerZero di atas kuota (persen). LayerZero mengembalikan
# sisa fee yang tidak terpakai di transaksi yang sama.
PACKET_FEE_MARGIN_PERCENT=10

# ---------------------------------------------------------------------------
# JADWAL & LOG
# ---------------------------------------------------------------------------
# Interval pengecekan dalam menit (default 60). 0 = sekali jalan lalu berhenti.
CHECK_INTERVAL_MINUTES=60
# File log harian di folder logs/. Kosongkan untuk log ke console saja.
LOG_DIR=logs

# ---------------------------------------------------------------------------
# DASHBOARD TERMINAL (saat jalan di terminal / SSH)
# ---------------------------------------------------------------------------
# Bila bot dijalankan di terminal (stdout adalah TTY), bot menampilkan
# dashboard live yang diperbarui berkala: statistik jaringan, tabel
# per-chain, panel wallet, hasil terakhir, dan log terakhir.
# Bila BUKAN terminal (mis. sebagai systemd service), bot OTOMATIS memakai
# log baris biasa — tanpa escape sequence ANSI ke journal log.
# Paksa log baris biasa walau di terminal:
# TERMINAL_UI=false
# LOG_PLAIN=true
TERMINAL_UI=true
LOG_PLAIN=false

# ---------------------------------------------------------------------------
# DASHBOARD WEB (halaman status + /api/status)
# ---------------------------------------------------------------------------
# WEB_DASHBOARD=true menyalakan server HTTP kecil di bot ini.
# Buka di browser (di VPS yang sama): http://127.0.0.1:8787
# atau via SSH tunnel: ssh -L 8787:127.0.0.1:8787 user@vps
# Halaman + endpoint /api/status HANYA menampilkan status publik dan alamat
# wallet TERPOTONG — cookie dan private key TIDAK PERNAH diekspos.
# WEB_HOST default 127.0.0.1 (hanya dari VPS itu sendiri). Jangan ubah ke
# 0.0.0.0 kecuali kamu paham risikonya dan membatasi akses (firewall).
WEB_DASHBOARD=false
WEB_PORT=8787
WEB_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# RPC (opsional — default sudah memakai RPC publik dari konfigurasi situs)
# ---------------------------------------------------------------------------
# Isi hanya bila RPC bawaan lambat / diblokir. Contoh:
# ZXO_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# ZXO_RPC_BASE=https://mainnet.base.org
# ZXO_RPC_OPTIMISM=https://mainnet.optimism.io
# ZXO_RPC_BNB=https://bsc-rpc.publicnode.com
# ZXO_RPC_AVALANCHE=https://avalanche-c-chain-rpc.publicnode.com
